# Database
DB_URL=jdbc:postgresql://postgres:5432/stayelite
DB_USERNAME=stayelite
DB_PASSWORD=replace-with-a-long-random-password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT secrets: use long random values in production
JWT_SECRET=replace-with-a-long-random-jwt-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret

# Stripe server secrets
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Frontend public values (embedded at next build time)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
NEXT_PUBLIC_MAPBOX_TOKEN=pk.replace_me
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# Production CORS origin(s), comma-separated
APP_CORS_ALLOWED_ORIGINS=https://stayelite.example.com
